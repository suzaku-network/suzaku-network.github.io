---
import snarkdown from "snarkdown";
import { riskCards } from "@/data/riskCards";
import Section from "@/components/Section.astro";

const renderedCards = riskCards.filter(c => !c.hidden).map(c => ({
  ...c,
  bodyHtml: snarkdown(c.body),
  tagText:  c.tags.join(" · "),
}));
---

<!--
  500vh total = 100vh sticky viewport + 400vh scroll budget.
  HOLD_W=0: no idle hold phases. Scroll budget is split into (N-1)=3 pure transition
  segments. snap[i] = outerTop + i/(N-1) * budget, evenly spaced.
    transition ≈ 133vh per step (Lenis animates this in 0.8s with ease-out cubic)

  Each card's animation is driven by k = i - scrollProgress where scrollProgress ∈ [0, N-1]:
    k = 0          → card is at the front (active)
    k > 0          → card is in the stack, offset to the right
    k < 0          → card is exiting to the left
-->
<Section id="the-risks" class="h-[500vh]">
  <div class="sticky top-0 h-screen flex items-center overflow-hidden">
    <div class="w-full px-6 mt-0 lg:mt-16">
      <div class="max-w-3xl mx-auto">

        <p class="type-label text-suzaku-green/80 mb-2 sm:mb-3 text-sm sm:text-xl">The risks</p>
        <h2 class="type-heading mb-2 sm:mb-3">What's really at stake</h2>
        <p class="type-subheading text-white/40 mb-4 sm:mb-8 text-sm sm:text-xl">
          Centralized validator sets carry invisible risks.<br />Until a hack, an
          outage, or a legal order...
        </p>

        <!--
          All cards share grid-area 1/1 so they stack in the same cell.
          The container height = tallest card; no absolute positioning needed.
        -->
        <div id="card-stack" style="display: grid;">
          {renderedCards.map((card, i) => (
            <div
              class="risk-card bg-suzaku-black border border-suzaku-green rounded-lg overflow-hidden flex flex-col"
              data-index={i}
              style="grid-area: 1 / 1; will-change: transform, opacity;"
            >
              <!-- Image area -->
              <div class="news-photo relative aspect-[3/1]">
                <img
                  src={card.image}
                  alt={card.headline}
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <a
                  href={card.articleUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="article-link absolute top-3 right-3 z-10"
                >
                  <p class="article-link-eyebrow">Read our blog article</p>
                  <p class="article-link-title">{card.articleLabel}&nbsp;↗</p>
                </a>
              </div>

              <!-- Text area -->
              <div class="px-4 py-4 sm:px-7 sm:py-5 flex flex-col border-t border-white/10 gap-2">
                <p class="news-tag">{card.tagText}</p>
                <h3 class="news-headline">{card.headline}</h3>
                <div class="h-px bg-white/10"></div>
                <div class="sm:h-[5.5rem] sm:overflow-hidden">
                  <p class="card-body text-white/50 leading-relaxed" set:html={card.bodyHtml} />
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </div>
</Section>

<script>
  import lenis from '@/utils/lenis';
  import { initStepScroll } from '@/utils/stepScroll';
  import { SNAP_DURATION_MS } from '@/utils/sectionSnap';

  const outer = document.getElementById("the-risks") as HTMLElement;
  const stack = document.getElementById("card-stack") as HTMLElement;
  const cardEls = Array.from(stack.querySelectorAll<HTMLElement>(".risk-card"));
  const N = cardEls.length;

  // ── Piecewise scroll mapping ───────────────────────────────────────────────
  // Timeline per card: [hold] then [transition to next] (last card: hold only).
  // HOLD_W and TRANS_W are relative scroll-budget weights.
  const HOLD_W  = 0; // no idle hold — 100% of scroll budget drives animation
  const TRANS_W = 1; // scroll budget weight while card transitions out
  const totalW  = N * HOLD_W + (N - 1) * TRANS_W;

  interface Seg { r0: number; r1: number; m0: number; m1: number; }
  const segs: Seg[] = [];
  let cum = 0;
  for (let i = 0; i < N; i++) {
    // Hold: scrollProgress stays flat at i
    segs.push({ r0: cum / totalW, r1: (cum + HOLD_W) / totalW, m0: i, m1: i });
    cum += HOLD_W;
    if (i < N - 1) {
      // Transition: scrollProgress moves from i to i+1
      segs.push({ r0: cum / totalW, r1: (cum + TRANS_W) / totalW, m0: i, m1: i + 1 });
      cum += TRANS_W;
    }
  }

  function remapProgress(raw: number): number {
    for (const s of segs) {
      if (raw <= s.r1) {
        if (s.r1 === s.r0) return s.m0;
        return s.m0 + ((raw - s.r0) / (s.r1 - s.r0)) * (s.m1 - s.m0);
      }
    }
    return N - 1;
  }

  function update() {
    const rect      = outer.getBoundingClientRect();
    const vh        = window.innerHeight;
    const scrolled  = Math.max(0, Math.min(outer.offsetHeight - vh, -rect.top));
    const rawProgress = (outer.offsetHeight - vh) > 0
      ? scrolled / (outer.offsetHeight - vh)
      : 0;
    // scrollProgress ∈ [0, N-1] with flat hold plateaus at each integer
    const scrollProgress = remapProgress(rawProgress);

    cardEls.forEach((card, i) => {
      // k < 0 → exiting left  |  k = 0 → front  |  k > 0 → stacked right
      const k = i - scrollProgress;

      let x: number, y: number, scl: number, opacity: number, zIdx: number;

      if (k < 0) {
        // Slide out to the left and fade
        const t = Math.min(1, -k);
        x       = -110 * t;
        y       = 0;
        scl     = 1 - 0.12 * t;
        opacity = Math.max(0, 1 - t * 2.5);
        // Stay on top while still visible, go behind once fully faded
        zIdx    = opacity > 0 ? 15 : 0;
      } else {
        // In the stack: offset right + scale proportional to k
        const clamped = Math.min(k, 3);
        x       = clamped * 4;    // shift 4% right per stack position
        y       = clamped * 0.5;  // drift 0.5% down per stack position
        scl     = 1 - clamped * 0.05;
        opacity = 1;
        zIdx    = 10 - Math.floor(k);
      }

      card.style.transform = `translateX(${x}%) translateY(${y}%) scale(${scl})`;
      card.style.opacity   = String(Math.max(0, Math.min(1, opacity)));
      card.style.zIndex    = String(Math.max(0, zIdx));
    });
  }

  let isResetting = false;

  function resetCards() {
    isResetting = true;
    cardEls.forEach((card, i) => {
      const clamped = Math.min(i, 3);
      card.style.transform = `translateX(${clamped * 4}%) translateY(${clamped * 0.5}%) scale(${1 - clamped * 0.05})`;
      card.style.opacity = '1';
      card.style.zIndex = String(10 - i);
    });
  }

  // Use lenis.on('scroll') so update() fires synchronously in Lenis's rAF loop,
  // after setScroll() has already updated window.scrollY. This ensures
  // getBoundingClientRect() reads the current frame's scroll position with no lag.
  // Guard with isResetting so the backward animation is suppressed during re-entry.
  lenis.on('scroll', () => { if (!isResetting) update(); });

  initStepScroll({
    outerEl: outer,
    stepCount: N,
    holdWeight: HOLD_W,
    transWeight: TRANS_W,
    onLeave: resetCards,
    resetDelay: SNAP_DURATION_MS,
    onResetEnd: () => { isResetting = false; },
  });

  update();
</script>

<style>
  .news-photo {
    background-color: rgba(255, 255, 255, 0.025);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 3px,
      rgba(255, 255, 255, 0.018) 3px,
      rgba(255, 255, 255, 0.018) 4px
    );
  }

  .news-tag {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(67, 246, 171, 0.65);
    height: 1.4em;
  }

  .news-headline {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.15;
    text-transform: uppercase;
    color: white;
    letter-spacing: 0.02em;
  }

  @media (min-width: 640px) {
    .news-headline { font-size: 3rem; }
  }

  .article-link {
    display: none;
    background-color: rgba(16, 16, 16, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 8px 12px;
    backdrop-filter: blur(8px);
    text-decoration: none;
    transition: border-color 0.15s ease;
    max-width: 300px;
  }

  @media (min-width: 640px) {
    .article-link { display: block; }
  }

  .article-link:hover {
    border-color: rgba(67, 246, 171, 0.4);
  }

  .article-link-eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 5px;
  }

  .article-link-title {
    font-size: 17px;
    font-weight: 600;
    color: rgba(67, 246, 171, 0.85);
    line-height: 1.3;
  }

  .article-link:hover .article-link-title {
    color: rgba(67, 246, 171, 1);
  }

  .card-body {
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .card-body { font-size: 1rem; }
  }

  @media (min-width: 768px) {
    .card-body { font-size: 1.25rem; }
  }

  /* Bold text in card body (rendered by snarkdown as <strong>) */
  .risk-card strong {
    font-weight: 800;
    color: rgba(255, 255, 255, 0.85);
  }
</style>
