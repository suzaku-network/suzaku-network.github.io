---
import ButtonHighlight from "@/components/ButtonHighlight.astro";
import ButtonStandard from "@/components/ButtonStandard.astro";
import Section from "@/components/Section.astro";
---

<Section id="hero" class="relative min-h-dvh flex flex-col items-center justify-center text-center px-6 pt-[68px]">
  <div class="absolute top-24 left-[max(1rem,calc(50%-32rem))]">
    <ButtonStandard
      href="/"
      label="← Back to homepage"
      external={false}
      class="text-xs sm:text-sm font-extrabold px-4 py-1.5 sm:px-5 sm:py-2 !border !border-white/10 hover:!border-suzaku-green"
    />
  </div>
  <p class="type-label text-suzaku-green/80 mb-8">For L1 builders</p>
  <h1 class="type-display max-w-4xl mb-8">
    Your L1's decentralization<br />doesn't matter.<br />
    <span class="bg-suzaku-gradient bg-clip-text text-transparent">
      Until it does.
    </span>
  </h1>
  <p class="type-subheading text-white/70 max-w-2xl mb-12">
    A centralized validator set is a silent liability.<br />One attack, one outage,
    one legal order.<br />All the value of your chain is at risk.
  </p>
  <div class="flex flex-row gap-3 sm:gap-4">
    <ButtonHighlight class="text-[0.85rem] sm:text-lg font-extrabold px-5 py-2 sm:px-8 sm:py-3" />
    <ButtonStandard class="text-[0.85rem] sm:text-lg font-extrabold px-5 py-2 sm:px-8 sm:py-3" />
  </div>
</Section>
