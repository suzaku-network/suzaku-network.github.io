---
---

<button
  id="scroll-to-top"
  aria-label="Back to top"
  class="fixed bottom-6 right-5 z-50 flex items-center justify-center w-10 h-10 rounded-full border border-white/20 bg-suzaku-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
  <svg
    class="w-4 h-4 text-white/70"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
  </svg>
</button>

<style is:global>
  #scroll-to-top.visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  import lenis from "@/utils/lenis";

  const btn = document.getElementById("scroll-to-top");

  function updateVisibility() {
    btn?.classList.toggle("visible", window.scrollY > window.innerHeight * 0.5);
  }

  window.addEventListener("scroll", updateVisibility, { passive: true });
  updateVisibility();

  btn?.addEventListener("click", () => {
    lenis.scrollTo(0, {
      lock: true,
      force: true,
      duration: 1.6,
      easing: (t: number) => 1 - Math.pow(1 - t, 4),
    });
  });
</script>
