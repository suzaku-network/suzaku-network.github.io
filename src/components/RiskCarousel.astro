---
import NewsCard from "@/components/NewsCard.astro";

const ARTICLE_URL = "https://suzaku.network/blog/why-l1-decentralization-matters-more-than-you-think";
const ARTICLE_LABEL = "Why L1 Decentralization Matters (More Than You Think)";

const cards = [
  {
    tags: ["Bridged TVL"],
    headline: "Hackers Drain All L1 TVL After Key Compromise",
    body: "If a single entity controls more than 67% of your L1's total weight, accessing their keys allows to bridge out all the TVL of your chain.",
    image: "/news/l1-tvl-drained-1200x400.png",
  },
  {
    tags: ["Liveness"],
    headline: "Operator Outage Causes L1 Halt for 6 Hours",
    body: "More than 20% of your network going offline will cause your chain to halt, and temporarily prevent all transactions from being processed.",
    image: "/news/l1-halted-1200x400.png",
  },
  {
    tags: ["Censorship"],
    headline: "AWS Blocks Access to Funds After Legal Order",
    body: "Cloud providers are private actors that can be coerced by regulators, and they can block access to funds after a legal order.",
    image: "/news/judgment-hammer-1200x400.png",
  },
  {
    tags: ["Hacks"],
    headline: "ByBit: $1.4B. Swissborg: $41.5M. Nobody is safe.",
    body: "As smart contract security improves, attackers look for OpSec failures. Any centralized setup will eventually be breached, whether it's your team or your service providers.",
    image: "/news/hacks-rekt-2025-1200x400.png",
  },
];
---

<!--
  Outer wrapper: 700vh = 100vh sticky frame + 600vh of scroll budget.
  The phase timeline distributes those 600vh proportionally across all
  type/erase/hold phases.
  Card data lives in data-cards so Astro always interpolates it (unlike
  <script type="application/json"> whose content is NOT template-evaluated).
-->
<div
  id="risks"
  class="h-[700vh]"
  data-cards={JSON.stringify(cards.map(c => ({ tags: c.tags, headline: c.headline, body: c.body, image: c.image })))}
>
  <div class="sticky top-0 h-screen flex items-center overflow-hidden">
    <section class="w-full px-6">
      <div class="max-w-5xl mx-auto">

        <p class="type-label text-suzaku-green/80 mb-3">The risks</p>
        <h2 class="type-heading mb-3">What's really at stake</h2>
        <p class="type-subheading text-white/40 mb-8 max-w-2xl">
          Centralized validator sets carry invisible risks.<br />Until a hack, an
          outage, or a legal order...
        </p>

        <!-- Single persistent card — text is written/erased by scroll-driven JS -->
        <NewsCard
          articleUrl={ARTICLE_URL}
          articleLabel={ARTICLE_LABEL}
        />

      </div>
    </section>
  </div>
</div>

<script>
  // ── Types ──────────────────────────────────────────────────────────────────
  type FieldName = "tags" | "headline" | "body";
  type PhaseDir  = "forward" | "reverse" | "hold";

  interface CardData {
    tags: string[];
    headline: string;
    body: string;
    image: string; // path relative to public/, empty string = no image
  }

  // A FieldAnim describes one field animated within a phase.
  // Multiple FieldAnims in the same Phase animate concurrently (same sub-progress).
  interface FieldAnim {
    field: FieldName;
    dir:   PhaseDir;
    text:  string;
  }

  interface Phase {
    anims:   FieldAnim[]; // one or more fields driven by the same sub-progress
    weight:  number;      // relative scroll budget (0 = instant / weight-less)
    cardIdx: number;      // which card this phase belongs to (drives image updates)
  }

  // ── Load card data ─────────────────────────────────────────────────────────
  const outer = document.getElementById("risks") as HTMLElement;
  const cardsData: CardData[] = JSON.parse(outer.dataset.cards ?? "[]");

  // ── Build phase timeline ───────────────────────────────────────────────────
  // Card 0           : type tags → type headline → type body → hold
  // Transition N→N+1 : erase headline (animated)
  //                    erase body instantly   (weight 0)
  //                    erase tags instantly   (weight 0)
  //                    type tags + headline concurrently → type body → hold
  // Last card        : same transition in, then type tags+headline → type body
  //                    (no hold, no erase out)
  function buildTimeline(cards: CardData[]): Phase[] {
    const phases: Phase[] = [];

    for (let i = 0; i < cards.length; i++) {
      const card    = cards[i];
      const tagText = card.tags.join(" · ");

      if (i > 0) {
        const prev     = cards[i - 1];
        const prevTags = prev.tags.join(" · ");

        // Erase headline (scroll-animated) — still showing the old card's image
        phases.push({ anims: [{ field: "headline", dir: "reverse", text: prev.headline }], weight: 4, cardIdx: i - 1 });
        // Erase body and tags instantly (weight 0) — image switches here alongside text
        phases.push({ anims: [{ field: "body", dir: "reverse", text: prev.body     }], weight: 0, cardIdx: i });
        phases.push({ anims: [{ field: "tags", dir: "reverse", text: prevTags      }], weight: 0, cardIdx: i });

        // Type new tags and headline concurrently
        phases.push({
          anims: [
            { field: "tags",     dir: "forward", text: tagText       },
            { field: "headline", dir: "forward", text: card.headline },
          ],
          weight: 4,
          cardIdx: i,
        });
      } else {
        // Card 0: tags and headline type concurrently
        phases.push({
          anims: [
            { field: "tags",     dir: "forward", text: tagText       },
            { field: "headline", dir: "forward", text: card.headline },
          ],
          weight: 4,
          cardIdx: i,
        });
      }

      // Type body
      phases.push({ anims: [{ field: "body", dir: "forward", text: card.body }], weight: 5, cardIdx: i });

      // Hold so the reader can finish the body (all cards except the last)
      if (i < cards.length - 1) {
        phases.push({ anims: [{ field: "body", dir: "hold", text: card.body }], weight: 2, cardIdx: i });
      }
    }

    return phases;
  }

  const phases      = buildTimeline(cardsData);
  const totalWeight = phases.reduce((s, p) => s + p.weight, 0);

  // cumWeights[i] = sum of weights of phases 0..i-1
  const cumWeights: number[] = [];
  let cum = 0;
  for (const p of phases) {
    cumWeights.push(cum);
    cum += p.weight;
  }

  // ── DOM refs ───────────────────────────────────────────────────────────────
  const fieldEls: Record<FieldName, HTMLElement> = {
    tags:     document.getElementById("card-tags")     as HTMLElement,
    headline: document.getElementById("card-headline") as HTMLElement,
    body:     document.getElementById("card-body")     as HTMLElement,
  };

  const cursorEls: Record<FieldName, HTMLElement> = {
    tags:     document.getElementById("tags-cursor")     as HTMLElement,
    headline: document.getElementById("headline-cursor") as HTMLElement,
    body:     document.getElementById("body-cursor")     as HTMLElement,
  };

  const imgEl = document.getElementById("card-image") as HTMLImageElement;

  // ── Scroll driver ──────────────────────────────────────────────────────────
  function updateFromScroll() {
    const rect     = outer.getBoundingClientRect();
    const vh       = window.innerHeight;
    const scrolled = Math.max(0, Math.min(outer.offsetHeight - vh, -rect.top));
    const progress = scrolled / (outer.offsetHeight - vh);

    const sw = progress * totalWeight;

    // Find current phase: last phase whose cumWeight ≤ sw.
    // Weight-0 phases are skipped here (their cumWeight equals the next phase),
    // so they are always treated as already-completed in the backward state scan.
    let phaseIdx = 0;
    for (let i = phases.length - 1; i >= 0; i--) {
      if (sw >= cumWeights[i]) {
        phaseIdx = i;
        break;
      }
    }

    const phase     = phases[phaseIdx];
    const phaseEndW = phaseIdx + 1 < phases.length ? cumWeights[phaseIdx + 1] : totalWeight;
    const phaseW    = phaseEndW - cumWeights[phaseIdx];
    const sub       = phaseW > 0 ? Math.min(1, (sw - cumWeights[phaseIdx]) / phaseW) : 1;

    // ── Render each text field ───────────────────────────────────────────────
    const fields: FieldName[] = ["tags", "headline", "body"];

    for (const field of fields) {
      // Check if the current phase animates this field
      const curAnim = phase.anims.find(a => a.field === field);

      let text = "";

      if (curAnim) {
        // Currently animating — apply sub-progress
        const len = curAnim.text.length;
        if (curAnim.dir === "forward") {
          text = curAnim.text.slice(0, Math.floor(sub * len));
        } else if (curAnim.dir === "reverse") {
          text = curAnim.text.slice(0, Math.floor((1 - sub) * len));
        } else {
          text = curAnim.text; // hold: static
        }
      } else {
        // Scan backwards for the most recent completed phase that touched this field
        let pastAnim: FieldAnim | null = null;
        for (let i = phaseIdx - 1; i >= 0; i--) {
          const a = phases[i].anims.find(x => x.field === field);
          if (a) { pastAnim = a; break; }
        }
        if (pastAnim) {
          text = (pastAnim.dir === "forward" || pastAnim.dir === "hold") ? pastAnim.text : "";
        }
      }

      fieldEls[field].textContent = text;
    }

    // ── Image: switch to the current card's image ────────────────────────────
    const imgSrc = cardsData[phase.cardIdx]?.image ?? "";
    if (imgEl.src !== imgSrc) imgEl.src = imgSrc; // avoid redundant assignments
    imgEl.classList.toggle("hidden", !imgSrc);

    // ── Cursor: show on the last anim's field in the current phase ────────────
    // For single phases this is that field; for concurrent type phases this is
    // "headline" (last in the anims array), keeping one cursor visible.
    const cursorField = phase.anims[phase.anims.length - 1].field;
    for (const field of fields) {
      cursorEls[field].classList.toggle("hidden", field !== cursorField);
    }
  }

  let ticking = false;
  window.addEventListener("scroll", () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateFromScroll();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  updateFromScroll();
</script>
