---
interface Props {
  /** Optional external article link — renders a small overlay card on the image */
  articleUrl?: string;
  /** Label shown as the title line of the article overlay */
  articleLabel?: string;
}

const { articleUrl, articleLabel = "Why Decentralization Matters" } = Astro.props;
---

<!--
  Single persistent card shell. Tags, headline, and body text targets are empty
  spans whose textContent is driven by the scroll-based typewriter in TheRisks.
  Each field has its own cursor that JS shows/hides depending on which field is
  currently animating.
-->
<div class="risk-tile border border-suzaku-green rounded-lg overflow-hidden flex flex-col max-w-3xl mx-auto">

  <!-- Image area — fixed height -->
  <div class="news-photo relative aspect-[3/1]">
    <!-- Crosshatch placeholder; covered by the img when a real image is set -->
    <span class="photo-label absolute bottom-2 left-3 select-none">Image</span>

    <!--
      src and visibility are driven by JS (updateFromScroll sets it per card).
      Starts hidden so the crosshatch shows on cards with no image.
    -->
    <img
      id="card-image"
      src=""
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      style="opacity: 0"
    />

    {articleUrl && (
      <a
        href={articleUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="article-link absolute top-3 right-3 z-10"
      >
        <p class="article-link-eyebrow">Read our blog article</p>
        <p class="article-link-title">{articleLabel}&nbsp;↗</p>
      </a>
    )}
  </div>

  <!-- Text — auto height, body capped at 3 lines -->
  <div class="px-7 py-5 flex flex-col border-t border-white/10 gap-2">

    <p class="news-tag overflow-hidden">
      <span id="card-tags"></span><span class="tw-cursor hidden" id="tags-cursor">|</span>
    </p>

    <h3 class="news-headline overflow-hidden">
      <span id="card-headline"></span><span class="tw-cursor hidden" id="headline-cursor">|</span>
    </h3>

    <div class="h-px bg-white/10"></div>

    <!-- h-[5.5rem] ≈ 3 lines of text-lg leading-relaxed -->
    <div class="h-[5.5rem] overflow-hidden">
      <p class="text-lg text-white/50 leading-relaxed">
        <span id="card-body"></span><span class="tw-cursor hidden" id="body-cursor">|</span>
      </p>
    </div>

  </div>
</div>

<style>
  .news-photo {
    background-color: rgba(255, 255, 255, 0.025);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 3px,
      rgba(255, 255, 255, 0.018) 3px,
      rgba(255, 255, 255, 0.018) 4px
    );
  }

  .photo-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.15);
  }

  .news-tag {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(67, 246, 171, 0.65);
    /* Fixed height so the row never shifts when text is empty or partially typed */
    height: 1.4em;
  }

  .news-headline {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.15;
    text-transform: uppercase;
    color: white;
    letter-spacing: 0.02em;
  }

  .article-link {
    background-color: rgba(16, 16, 16, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 8px 12px;
    backdrop-filter: blur(8px);
    text-decoration: none;
    display: block;
    transition: border-color 0.15s ease;
    max-width: 300px;
  }

  .article-link:hover {
    border-color: rgba(67, 246, 171, 0.4);
  }

  .article-link-eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 5px;
  }

  .article-link-title {
    font-size: 17px;
    font-weight: 600;
    color: rgba(67, 246, 171, 0.85);
    line-height: 1.3;
  }

  .article-link:hover .article-link-title {
    color: rgba(67, 246, 171, 1);
  }

  /* Bold spans inside the body typewriter */
  .body-bold {
    font-weight: 800;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Cursor blinks while visible; Tailwind's `hidden` class (display:none) suppresses it */
  .tw-cursor {
    color: rgba(67, 246, 171, 0.7);
    animation: blink 0.9s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>
