---
interface Props {
  hoverColor?: "teal" | "green";
  padding?: "sm" | "md" | "lg";
  class?: string;
}

const { hoverColor = "green", padding = "md", class: className } = Astro.props;

const paddingClass = { sm: "p-5", md: "p-6", lg: "p-8" }[padding];
const hoverClass = hoverColor === "green"
  ? "hover:border-suzaku-green"
  : "hover:border-suzaku-teal";
---

<div class:list={["border border-white/10 rounded-lg bg-white/[0.02] transition-colors", paddingClass, hoverClass, className]}>
  <slot />
</div>
