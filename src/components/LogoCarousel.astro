---
const logos = [
  { src: "/partners/ecosystem/50-partners-logo.png", alt: "50 Partners" },
  { src: "/partners/ecosystem/ash-logo.png", alt: "Ash" },
  { src: "/partners/ecosystem/avalanche-logo.svg", alt: "Avalanche" },
  { src: "/partners/ecosystem/benqi-logo.svg", alt: "BENQI" },
  { src: "/partners/ecosystem/blackhole-logo.svg", alt: "Blackhole" },
  { src: "/partners/ecosystem/blizzard-white.svg", alt: "Blizzard" },
  { src: "/partners/ecosystem/codebase-logo.png", alt: "Codebase" },
  { src: "/partners/ecosystem/swissborg-logo.svg", alt: "SwissBorg" },
  { src: "/partners/ecosystem/yieldyak-logo.png", alt: "YieldYak" },
];
---

<div class="relative overflow-hidden logo-carousel-mask">
  <div id="logo-track" class="flex items-center gap-16 w-max">
    {logos.map((logo) => (
      <img
        src={logo.src}
        alt={logo.alt}
        class="w-44 h-auto object-contain opacity-60 flex-shrink-0 brightness-0 invert"
      />
    ))}
    {logos.map((logo) => (
      <img
        src={logo.src}
        alt=""
        aria-hidden="true"
        class="w-44 h-auto object-contain opacity-60 flex-shrink-0 brightness-0 invert"
      />
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    from { transform: translateX(0) }
    to   { transform: translateX(-50%) }
  }
  #logo-track {
    animation: marquee 28s linear infinite;
  }
  #logo-track:hover {
    animation-play-state: paused;
  }
  .logo-carousel-mask {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
</style>
