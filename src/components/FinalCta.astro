---
import ButtonAudit from "@/components/ButtonAudit.astro";
import ButtonTalk from "@/components/ButtonTalk.astro";
import Section from "@/components/Section.astro";
---

<Section id="final-cta" class="py-32 px-6 text-center">
  <div class="max-w-3xl mx-auto">
    <h2 class="type-heading mb-6">
      Start with a free audit.<br />
      <span class="bg-suzaku-gradient bg-clip-text text-transparent">
        Know exactly where your L1 stands.
      </span>
    </h2>
    <p class="type-subheading text-white/40 mb-10">
      The L1 Auditor shows your decentralization stage in seconds. Free, no
      signup required.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <ButtonAudit class="type-btn px-10 py-4" />
      <ButtonTalk class="type-btn px-10 py-4" />
    </div>
  </div>
</Section>
