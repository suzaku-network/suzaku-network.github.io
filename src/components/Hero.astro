---
import ButtonAudit from "@/components/ButtonAudit.astro";
import ButtonTalk from "@/components/ButtonTalk.astro";
import Section from "@/components/Section.astro";
---

<Section id="hero" class="min-h-screen flex flex-col items-center justify-center text-center px-6 pt-[68px]">
  <p class="type-label text-suzaku-green/80 mb-8">For L1 builders</p>
  <h1 class="type-display max-w-4xl mb-8">
    Your L1's decentralization<br />doesn't matter.<br />
    <span class="bg-suzaku-gradient bg-clip-text text-transparent">
      Until it does.
    </span>
  </h1>
  <p class="type-subheading text-white/50 max-w-2xl mb-12">
    A centralized validator set is a silent liability.<br />One attack, one outage,
    one legal order.<br />All the value of your chain is at risk.
  </p>
  <div class="flex flex-col sm:flex-row gap-4">
    <ButtonAudit class="type-btn px-8 py-3" />
    <ButtonTalk class="type-btn px-8 py-3" />
  </div>
</Section>
