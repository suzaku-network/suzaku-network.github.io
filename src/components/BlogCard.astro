---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Author } from "@/data/authors";

interface Props {
  title: string;
  description: string;
  date: Date;
  image: ImageMetadata;
  imageAlt: string;
  slug: string;
  author: Author | undefined;
  tags?: string[];
  eager?: boolean;
}

const { title, description, date, image, imageAlt, slug, author, tags, eager = false } =
  Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a
  href={`/blog/${slug}`}
  class="group flex flex-col border border-white/10 rounded-lg bg-white/[0.02] hover:border-suzaku-green transition-colors overflow-hidden"
>
  <!-- Thumbnail -->
  <div class="aspect-video overflow-hidden bg-white/5">
    <Image
      src={image}
      alt={imageAlt}
      width={600}
      height={338}
      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </div>

  <!-- Content -->
  <div class="flex flex-col gap-3 p-6 flex-1">
    {
      tags && tags.length > 0 && (
        <p class="type-caption font-extrabold tracking-widest uppercase text-suzaku-green/80 text-xs">
          {tags.join(" · ")}
        </p>
      )
    }

    <h2 class="type-card-title text-white leading-snug">{title}</h2>

    <p class="type-caption text-white/50 line-clamp-3 flex-1">{description}</p>

    <!-- Author + date -->
    <div class="flex items-center gap-3 pt-2 border-t border-white/10 mt-auto">
      {
        author?.avatar ? (
          <Image
            src={author.avatar}
            alt={author.name}
            width={28}
            height={28}
            class="w-7 h-7 rounded-full object-cover shrink-0"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="w-7 h-7 rounded-full bg-suzaku-teal/20 shrink-0 flex items-center justify-center">
            <span class="text-suzaku-teal text-xs font-extrabold">
              {author?.name?.[0] ?? "?"}
            </span>
          </div>
        )
      }
      <div class="flex flex-col min-w-0">
        {
          author && (
            <span class="type-caption text-white/70 font-semibold truncate">
              {author.name}
            </span>
          )
        }
        <span class="type-caption text-white/30 text-sm">{formattedDate}</span>
      </div>
    </div>
  </div>
</a>
