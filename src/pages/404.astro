---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — Page not found | Suzaku">
  <div class="min-h-screen flex flex-col items-center justify-center text-center px-6">
    <p class="type-label text-suzaku-green/80 mb-6">404</p>
    <h1 class="type-heading mb-6">Page not found.</h1>
    <p class="type-subheading text-white/40 mb-10 max-w-md">
      This page doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="type-btn-sm text-suzaku-black bg-suzaku-gradient px-6 py-2.5 rounded hover:opacity-90 transition-opacity"
    >
      Back to home →
    </a>
  </div>
</Layout>
